# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Obsidian device-specific state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# Plugin data can contain API tokens/keys — never commit
.obsidian/plugins/*/data.json

# Obsidian Git generates this per-device at runtime — not portable
.obsidian/plugins/obsidian-git/obsidian_askpass.sh

# Secrets
.env
*.key
*.pem

# MCP config holds the Local REST API bearer token — never commit
.mcp.json
